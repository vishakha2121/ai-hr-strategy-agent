# --------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
hr_data.db
*.db-wal
*.db-shm

# --------------------------------------------
# 📊 DATA FILES (Large)
# --------------------------------------------
backend/data/raw/*.csv
backend/data/processed/*.csv
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
*.parquet
*.feather
*.h5

# --------------------------------------------
# 📁 LOGS
# --------------------------------------------
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------
# ⚛️ NODE / REACT / FRONTEND
