api_keys.txt

# Model training artifacts
backend/ml/saved_models/*.pkl
backend/ml/saved_models/*.joblib
backend/ml/*.log

# Prediction cache
backend/data/predictions_cache/

# --------------------------------------------
# ✅ KEEP THESE (Whitelist)
# --------------------------------------------
!.gitkeep
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/ml/saved_models/.gitkeep
!.env.example
!README.md
!LICENSE