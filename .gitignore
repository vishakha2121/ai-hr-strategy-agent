*~
.directory
.Trash-*

# --------------------------------------------
# 🧪 TESTING
# --------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.bandit

